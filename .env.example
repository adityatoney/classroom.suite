# ============================================================
# ClassroomSuite — Project #8 (port base 10810)
# ============================================================
# Copy to .env (committed: port + SSD path; uncommitted: secrets in .env.local)

# ── Ports ────────────────────────────────────────────────────
CS_PORT_CONVEX=10810           # Convex backend API
CS_PORT_API=10811              # FastAPI OCR sidecar (+1)
CS_PORT_WEB=10813              # Next.js frontend (Docker, +3)
CS_PORT_WEB_DEV=10814          # Next.js frontend (local dev, +4)
CS_PORT_SITE_PROXY=10815       # Convex site proxy (+5)
CS_PORT_DASHBOARD=10817        # Convex dashboard (+7)

# ── Persistent volume on external SSD ────────────────────────
SSD_DATA=/Volumes/DevSSD/docker-data

# ── Convex client (read by the web app) ──────────────────────
# Dev: same-origin proxy through Next.js (see web/next.config.ts)
NEXT_PUBLIC_CONVEX_URL=http://localhost:10814/convex
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:10815
NEXT_PUBLIC_API_URL=http://localhost:10811

# ── Convex backend env (set via `npx convex env set`; never committed) ──
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# SITE_URL=http://localhost:10814
# JWT_PRIVATE_KEY=...      # generated by scripts/setup-local-convex.sh
# JWKS=...                 # generated by scripts/setup-local-convex.sh
# RESEND_API_KEY=re_...
